// 断面諸定数の演算 
function calculate(){

    for(let floor = 1; floor <= 3; floor++){

        const B = Number(document.getElementById(`b${floor}`).value);

        const D = Number(document.getElementById(`d${floor}`).value);
        
        const lk = Number(document.getElementById(`lk${floor}`).value);

        if(!B || !D || !lk){
            continue;
        }

        const A = round(B * D);

        const Z = round(B * D ** 2 / 6);

        const I = round(B * D ** 3 / 12);

        const si = round(Math.sqrt(I / A));

        const lamda = round(lk / si * 100);

        let eta;

        if(lamda <= 30){
            eta = 1;
        }
        else if(lamda > 100){
            eta = round(3000 / lamda ** 2);
        }
        else{
            eta = round(1.3 - 0.01 * lamda);
        }
    
        document.getElementById(`a${floor}`).value = A;
        document.getElementById(`z${floor}`).value = Z;
        document.getElementById(`i${floor}`).value = I;
        document.getElementById(`si${floor}`).value = si;
        document.getElementById(`lamda${floor}`).value = lamda;
        document.getElementById(`eta${floor}`).value = eta;

    }

}

