// 屋根勾配取得
function getRoofSlope() {
    return Number(
        document.getElementById("roofSlope").value
    ) || 0;
}

// 屋根角度Θ取得
function getTheta(){
    const beta = getRoofSlope();

    const theta = 
        Math.atan(beta) * 180 /Math.PI;

   return theta;
}

//屋根形状係数の計算
function calcRoofSnowCoef(){

    const theta = getTheta();

    let mu;

    if(theta <= 60){

        mu = round(
            Math.sqrt(
                Math.cos(
                    1.5 * theta * Math.PI / 180
                )
            )
        );

    }
    else{

        mu = 0;

    }

    document.getElementById(
        "roofSnowCoef"
    ).value = mu;

    return mu;

}

//積雪荷重の計算
function calcSnowLoad(){

    const snowArea =
        document.getElementById("snowArea").value;

    const snowDepth = 
        Number(
            document.getElementById("snowDepth").value
        );
    
    const snowUnit =
        Number(
            document.getElementById("snowUnit").value
        );

    if (
        snowArea === "general" &&
        snowUnit < 20
    ){
        alert(
            "一般地域は雪の単位重量20(N/m²/cm)以上入力してください"
        );
        return;
    }

    if (
        snowArea === "heavy" &&
        snowUnit < 30
    ){
        alert(
            "多雪区域は単位重量30(N/m²/cm)以上入力してください"
        );
        return;
    }

    // μb計算
    const mu =
        calcRoofSnowCoef();

    // 設計積雪荷重計算
    const snowLoad =
        Math.round(
            snowDepth *
            snowUnit *
            mu *
            100
        ) / 100;

    document.getElementById(
        "snowLoad"
    ).value = snowLoad;

}

