//最高高さと軒高の平均値Hの計算
function getH(){

    const maxHeight =
        Number(document.getElementById("maxHeight").value);

    const eaveHeight =
        Number(document.getElementById("eaveHeight").value);

    return (maxHeight + eaveHeight) / 2;

}

//Erの計算
function calcEr(){

    const Zb =
        Number(document.getElementById("Zb").value);

    const ZG =
        Number(document.getElementById("ZG").value);

    const alfaW =
        Number(document.getElementById("alfaW").value);
    
    const H = getH();

    let Er = 0;

    if (H <= Zb){

        Er = 1.7 * (Zb / ZG) ** alfaW;

    }else{

        Er = 1.7 * (H / ZG) ** alfaW;
    }

    document.getElementById("Er").value = Er.toFixed(3);

    calcE();

}

//ガスト影響係数Gfの計算
function calcGf(){

    const roughnessClass =
        document.getElementById("roughnessClass").value;
        
    const H = getH();

    let Gf10 = 0;
    let Gf40 = 0;
    let Gf = 0;

    switch(roughnessClass){

        case "one":
            Gf10 = 2.0;
            Gf40 = 1.8;
            break;
        
        case "two":
            Gf10 = 2.2;
            Gf40 = 2.0;
            break;

        case "three":
            Gf10 = 2.5;
            Gf40 = 2.1;
            break;

        case "four":
            Gf10 = 3.1;
            Gf40 = 2.3;
            break;
    }

    if (H <= 10){

        Gf=Gf10
    
    }else if(H >= 40){

        Gf=Gf40

    }else{
        Gf =
            Gf10 + (Gf40 - Gf10) * (H - 10) / 30;
    }

    document.getElementById("Gf").value = Gf.toFixed(2);

    calcE();

}

//Eの計算（屋根の高さ、地表面粗度区分に応じて定められる数値）
function calcE(){

    const Er =
        Number(document.getElementById("Er").value);

    const Gf =
        Number(document.getElementById("Gf").value);

    const E = Er ** 2 * Gf;

    document.getElementById("E").value =
        E.toFixed(3);

    calcq();

}

//速度圧qの計算
function calcq(){

    const E =
        Number(document.getElementById("E").value);

    const V0 =
        Number(document.getElementById("V0").value);
    
    const q = 0.6 * E * V0 ** 2;

    document.getElementById("q").value =
        q.toFixed(2);

    return q;
}

// 風力係数Cfの計算
function calcWindCf(){

    const theta = getTheta();

    if(isNaN(theta)){
        alert(
            "屋根勾配を入力してください。"
        );
        return;
    }

    // Θをコンソールで確認
    console.log("theta=", theta);

    // 外圧係数（正・負）
    let Cpep;
    let Cpem;

    // 風上（正）
    let Cfup1;
    let Cfup2;

    // 風上（負）
    let Cfum1;
    let Cfum2;

    // 風下（正）
    let Cfdp1;
    let Cfdp2;

    // 風下（負）
    let Cfdm1;
    let Cfdm2;

    // ΣCf（正）
    let sigmaCfp1;
    let sigmaCfp2;

    // ΣCf（負）
    let sigmaCfm1;
    let sigmaCfm2;

    // ΣCf（最大値）
    let sigmaCf;

    //屋根面Cf
    let sigmaCfr1;
    let sigmaCfr2;
    let sigmaCfr3;

    //壁面Cf
    let sigmaCfw1;
    let sigmaCfw2;
    let sigmaCfw3;

/*風力係数関係メモ
    Cpep : 勾配屋根の風上側外圧係数（正）
    Cpem : 勾配屋根の風上側外圧係数（負）
    
    ※1 勾配屋根の風下側外圧係数は-0.5
    ※2 風上壁面の外圧係数 Cpeu=0.8kz だが、低層建築物としてkz=1.0とみなす
    　　風下壁面の外圧係数 Cped=-0.4
    
    Cfup : 風上（正）
    Cfum : 風上（負）
    Cfdp : 風下（正）
    Cfdm : 風下（負）

    ここで添え字は下記を表す
    u : 風上
    d : 風下
    p : 正
    m : 負

    ※3 内圧係数Cpiは閉鎖型とし、0 及び -0.2 の2パターンを用いて計算する。
    Cfup,Cfum,Cfdp,Cfdmの末尾番号
    1 : Cpi = 0
    2 : Cpi = - 0.2
    
    ※4 風力係数Cfの計算は下記のとおり
    勾配屋根の風上：4パターンから最大値（Cpe 正・負 ×　Cpi 2パターンの合計4パターン）
    勾配屋根の風下：2パターンから最大値（Cpi 2パターン）
    壁面：下記の風上・風下の圧力差で算定することとし、両者とも1.2となるため、1.2を採用する。
        壁面の風上 : 0.8 と 1.0（Cpi 2パターン）
        壁面の風下 : -0.4 と -0.2（Cpi 2パターン）
*/

    if (theta < 10){

        Cpep = 0;
        Cpem = -1;

    }else if((theta >= 10) && (theta < 30)){

        Cpep = 0.2 / 20 * (theta - 10);
        Cpem = 0.7 / 20 * (theta - 10) - 1;

    }else if ((theta >= 30) && (theta <45)){

        Cpep = 0.2 / 15 * (theta -30) + 0.2;
        Cpem = 0.3 / 15 * (theta -30) - 0.3;

    }else if((theta >= 45) && (theta <90)){

        Cpep = 0.4 /45 * (theta -45) + 0.4;
        Cpem = 0;

    }else if (theta >= 90){

        Cpep = 0.8;
        Cpem = 0;

    }


    // 風上Cf（正）
    Cfup1 = Cpep;
    Cfup2 = Cpep - (-0.2);
    // 風上Cf（負）
    Cfum1 = Cpem;
    Cfum2 = Cpem - (-0.2);

    // 風下Cf（正）
    Cfdp1 = - 0.5;
    Cfdp2 = - 0.3;
    // 風下Cf（負）
    Cfdm1 = - 0.5;
    Cfdm2 = - 0.3;

    // 正の風力係数
    sigmaCfp1 = Cfup1 - Cfdp1;
    sigmaCfp2 = Cfup2 - Cfdp2;
    // 負の風力係数    
    sigmaCfm1 = Cfum1 - Cfdm1;
    sigmaCfm2 = Cfum2 - Cfdm2;

    // 勾配屋根 ΣCfの最大値
    sigmaCf = Math.max(
        Math.abs(sigmaCfp1),
        Math.abs(sigmaCfp2),
        Math.abs(sigmaCfm1),
        Math.abs(sigmaCfm2)
    );

    const windDirection = 
        document.getElementById("windDirection").value;
    
    const roofShape = 
        document.getElementById("roofShape").value;
    
    if (roofShape === "gableRoof"){
        if (windDirection === "beamDirection"){

            sigmaCfr3 = sigmaCf;
            sigmaCfr2 = sigmaCf;
            sigmaCfr1 = sigmaCf;

        }else if (windDirection === "girderDirection"){

            sigmaCfr3 = 1.2;
            sigmaCfr2 = 1.2;
            sigmaCfr1 = 1.2;

        }else{
            alert(
                "風向を選択してください。"
            )
        }
    }else if(roofShape === "hippedRoof"){

            sigmaCfr3 = sigmaCf;
            sigmaCfr2 = sigmaCf;
            sigmaCfr1 = sigmaCf;

    }else{
        alert(
            "屋根形状を選択してください。"
        )
    }

    sigmaCfw3 = 1.2;
    sigmaCfw2 = 1.2;
    sigmaCfw1 = 1.2;

    // 画面へ出力
    document.getElementById("sigmaCfr1").value = sigmaCfr1;
    document.getElementById("sigmaCfr2").value = sigmaCfr2;
    document.getElementById("sigmaCfr3").value = sigmaCfr3;

    document.getElementById("sigmaCfw1").value = sigmaCfw1;
    document.getElementById("sigmaCfw2").value = sigmaCfw2;
    document.getElementById("sigmaCfw3").value = sigmaCfw3;

    // 戻り値として返す
    return {
        sigmaCfr1,
        sigmaCfr2,
        sigmaCfr3,
        sigmaCfw1,
        sigmaCfw2,
        sigmaCfw3,
        sigmaCf
    };
}

//風圧力ΣQ計算
function calcSigmaQWi(){
    //速度圧
    const q = calcq();

    //風力係数
    const Cf = calcWindCf();

    // 屋根面積
    const Ar3 =
        Number(
            document.getElementById("Ar3").value
        );
    const Ar2 =
        Number(
            document.getElementById("Ar2").value
        );
    const Ar1 =
        Number(
            document.getElementById("Ar1").value
        );

    //壁面積
    const Aw3 =
        Number(
            document.getElementById("Aw3").value
        );
    const Aw2 =
        Number(
            document.getElementById("Aw2").value
        );
    const Aw1 =
        Number(
            document.getElementById("Aw1").value
        );

    //各階屋根面の風圧力
    const Wr3 =
        Cf.sigmaCfr3 * Ar3 * q;
    const Wr2 =
        Cf.sigmaCfr2 * Ar2 * q;
    const Wr1 =
        Cf.sigmaCfr1 * Ar1 * q;

    //各階壁面の風圧力
    const Ww3 =
        Cf.sigmaCfw3 * Aw3 * q;
    const Ww2 =
        Cf.sigmaCfw2 * Aw2 * q;
    const Ww1 =
        Cf.sigmaCfw1 * Aw1 * q;

    //各階風圧力Q
    const QW3 = Wr3 + Ww3;
    const QW2 = Wr2 + Ww2;
    const QW1 = Wr1 + Ww1;

    //各階風圧力ΣQ
    const sigmaQW3 = QW3;
    const sigmaQW2 = QW3 + QW2;
    const sigmaQW1 = QW3 + QW2 + QW1;
    
    // 画面へ出力
    document.getElementById("QW3").value =
        QW3.toFixed(2);

    document.getElementById("QW2").value =
        QW2.toFixed(2);

    document.getElementById("QW1").value =
        QW1.toFixed(2);

    document.getElementById("sigmaQW3").value =
        sigmaQW3.toFixed(2);

    document.getElementById("sigmaQW2").value =
        sigmaQW2.toFixed(2);

    document.getElementById("sigmaQW1").value =
        sigmaQW1.toFixed(2);

}

